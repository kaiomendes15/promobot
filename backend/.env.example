# Copy this file to .env and fill in the values.
# Never commit .env — it is listed in .gitignore.

# PostgreSQL connection string (provided by Render in production)
DATABASE_URL=postgresql://user:password@localhost:5432/promobot

# CloudAMQP connection string (used by aio-pika worker in M3)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Mercado Livre OAuth credentials (https://developers.mercadolivre.com.br)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_AFFILIATE_ID=

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# JWT settings — pick any long random string for JWT_SECRET
JWT_SECRET=changeme
JWT_ALGORITHM=HS256
